# LiteLLM 공식 이미지(판본·다이제스트 고정)에 MINT를 설치한 이미지.
ARG LITELLM_IMAGE=ghcr.io/berriai/litellm-database@sha256:7ef0e78fe00ad5ea7ea45666cc1d1f02cb7076aee69091543bf397de52db33ce

FROM python:3.13-slim@sha256:ae14d4ce8771606477a81446e7ef429edd6762305fc50c84507c1041fa8285d1 AS build
COPY pyproject.toml README.md LICENSE /src/
COPY src /src/src
RUN pip wheel --no-deps --wheel-dir /wheels /src

FROM ${LITELLM_IMAGE}
# 정책 시험과 번들 준비에 쓰는 opa 실행 파일과 정책 소스. 정책 엔진 이미지와 같은 판본이다.
COPY --from=openpolicyagent/opa:1.21.4@sha256:12420358d3f22a0cd2424ddc44a16e292ecb42825d3dfbca779986006822a3f6 /opa /usr/local/bin/opa
COPY policy /opt/mint/policy
COPY --from=build /wheels /tmp/wheels
# uv.lock에서 내보낸 판본 제약. 기반 이미지에 이미 있는 패키지는 그 판본을 유지하고 새로 설치하는 패키지만 잠금 판본을 쓴다.
COPY deploy/constraints.txt deploy/merge-constraints.py /tmp/
RUN python -m ensurepip     && python -m pip freeze > /tmp/base-freeze.txt     && python /tmp/merge-constraints.py /tmp/base-freeze.txt /tmp/constraints.txt > /tmp/merged.txt     && python -m pip install -c /tmp/merged.txt "$(ls /tmp/wheels/*.whl)[litellm]"     && python -m pip check     && python -m pip uninstall -y pip     && rm -rf /tmp/wheels /tmp/constraints.txt /tmp/merge-constraints.py /tmp/base-freeze.txt /tmp/merged.txt

# 비루트 사용자(기반 이미지의 nonroot)로 실행한다. 판정 버퍼·내보내기·정책 번들은 이 사용자가 쓰는 디렉터리이며,
# 이 경로에 처음 만들어지는 명명 볼륨은 이 소유자를 물려받는다(기존 볼륨은 mint.sh up이 소유자를 맞춘다).
RUN mkdir -p /var/lib/mint/buffer /var/lib/mint/export /bundles \
    && chown -R 65532:65532 /var/lib/mint /bundles
ENV HOME=/tmp

# LiteLLM을 시작하기 전에 설정 파일을 검사하는 진입점. 검사에 실패하면 컨테이너가 시작되지 않는다.
COPY deploy/mint-entrypoint.sh /usr/local/bin/mint-entrypoint
RUN chmod +x /usr/local/bin/mint-entrypoint
USER 65532:65532
ENTRYPOINT ["mint-entrypoint"]
CMD ["--port", "4000"]
