# 복사해서 .env로 쓴다. 모든 값을 배포 환경에 맞게 바꾼다.
POSTGRES_PASSWORD=change-me-postgres
MINT_PLUGIN_DB_PASSWORD=change-me-plugin
MINT_CONTROL_DB_PASSWORD=change-me-control
LITELLM_MASTER_KEY=sk-change-me-master

# 비워 두면 mint.sh가 처음 실행할 때 무작위로 만들어 .env에 적는다(.env는 0600으로 둔다).
# 작업 실행기·직원 화면 로그인 역할의 비밀번호와 내보내기 파일 서명 키(base64url 32바이트 이상).
# 서명 키를 바꿀 때는 새 키를 MINT_EXPORT_HMAC_KEY에, 옛 키를 MINT_EXPORT_HMAC_KEY_PREVIOUS에 두고 다시 기동한다.
MINT_WORKER_DB_PASSWORD=
MINT_STAFF_DB_PASSWORD=
MINT_EXPORT_HMAC_KEY=
MINT_EXPORT_HMAC_KEY_PREVIOUS=

# 배치 식별자와 모드 상한(enforce면 저장 설정으로 observe로 낮출 수 없다)
MINT_INSTANCE_ID=default
MINT_MODE=enforce

# 제어 평면 LiteLLM 키(proxy_admin 사용자 키, allowed_routes 제한). init 출력의 안내대로 발급해 넣는다.
MINT_LITELLM_KEY=

# 계약 관측 주기(초). 도구 정의가 승인본과 달라졌는지 업스트림을 다시 읽는 간격이다.
MINT_OBSERVE_SECONDS=3600

# 외부에 공개하는 주소와 OAuth 리다이렉트 출처
PROXY_BASE_URL=
MCP_TRUSTED_REDIRECT_ORIGINS=

# 호스트에 공개하는 LiteLLM 포트
MINT_LITELLM_PORT=4000

# 복제본 수(둘 이상이면 공유 Redis 설정이 필요하다고 check가 경고한다)
MINT_REPLICAS=1

# 인자 지문 키 등 비밀 파일을 둘 저장소 밖 디렉터리. 비워 두면 mint.sh가 ~/.config/mint를 쓴다.
MINT_SECRETS_DIR=

# 판정 프로세스 조정(기본값이 적당하다)
MINT_BUFFER_MAX_BYTES=52428800
MINT_DB_POOL_SIZE=8
MINT_DECISION_BUDGET_MS=300
MINT_SELFCHECK_GRACE_SECONDS=30

# 비워 두면 로그 설정을 바꾸지 않는다. DEBUG이면 도구 호출 판정마다 걸린 시간을 한 줄씩 남긴다(decision_ms=).
MINT_LOG_LEVEL=
# 한 기기에 스택을 여럿 둘 때 스택마다 다른 이름(컨테이너·볼륨·이미지 태그가 나뉜다)
# COMPOSE_PROJECT_NAME=mint-a
MINT_CONSOLE_PORT=8080
