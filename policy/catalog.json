  "checks": [
    {"id":"endpoint_stale_server","description":"설치 보고에 폐기된 서버 항목이 남음","output":"alert","reference_policies":["POL-D-02"]},
    {"id":"endpoint_unmanaged","description":"관리되지 않는 단말 설치(관리형에서만 게이트웨이 밖 MCP를 막음)","output":"alert","reference_policies":["POL-E-06"]},
    {"id":"endpoint_stale_process","description":"폐기·미승인 서버의 프로세스가 단말에 남음","output":"alert","reference_policies":["POL-D-04"]},
    {"id":"endpoint_stale_autostart","description":"폐기·미승인 서버의 자동 시작 항목이 단말에 남음","output":"alert","reference_policies":["POL-D-04"]},
    {"id":"endpoint_unsandboxed","description":"관리형 단말에서 로컬 서버가 격리 없이 실행됨","output":"alert","reference_policies":["POL-O-13","POL-I-08"]},
    {"id":"endpoint_silent","description":"설치 보고가 정해진 시간(기본 24시간) 넘게 끊김","output":"alert","reference_policies":["POL-D-04","POL-E-06"]},
    {"id":"endpoint_key_expiring","description":"단말 설치 묶음 키가 만료 7일 안인데 갱신되지 않음","output":"alert","reference_policies":["POL-E-06"]}
  ],
