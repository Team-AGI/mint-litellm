    {"id":"POL-E-07","class":"conditional","pr":null,"enforced_by":["policy/bundle/mint/policy.rego:272","src/mint_litellm/plugin/policy/patterns.py:183"],"limit":"계약 관리 서버만, 리터럴 URL만 본다(이름 해석 없음)."},
